<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Autonomous TPU optimization — demo</title>
<style>
  :root{
    --bg:#f7f8fa; --panel:#ffffff; --card:#ffffff; --text:#1a1d21; --muted:#5b6570;
    --subt:#8a929c; --border:#e6e9ee; --grid:#eceff3; --shadow:0 10px 40px rgba(20,30,50,.10);
    --add-bg:#e6ffed; --add-fg:#116329; --add-gutter:#22863a;
    --del-bg:#ffeef0; --del-fg:#a01326; --del-gutter:#cb2431;
    --hunk:#6f42c1; --meta:#8a929c; --codebg:#fbfcfd;
  }
  body.dark{
    --bg:#12151a; --panel:#1a1e25; --card:#1c212a; --text:#e9edf2; --muted:#9aa4b0;
    --subt:#6f7885; --border:#2a303a; --grid:#232932; --shadow:0 10px 40px rgba(0,0,0,.45);
    --add-bg:#12261c; --add-fg:#56d364; --add-gutter:#3fb950;
    --del-bg:#2b1518; --del-fg:#ff7b82; --del-gutter:#f85149;
    --hunk:#bc8cff; --meta:#6f7885; --codebg:#161a20;
  }
  *{box-sizing:border-box}
  html,body{height:100%}
  body{margin:0;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;
    background:var(--bg);color:var(--text);overflow:hidden;
    transition:background .4s ease,color .4s ease}

  /* ---- top bar ---- */
  #bar{display:flex;align-items:center;gap:16px;padding:14px 26px;
    border-bottom:1px solid var(--border);background:var(--panel)}
  .brand{display:flex;align-items:center;gap:11px;font-weight:650;font-size:15px}
  .icon{width:26px;height:26px;flex:0 0 26px;display:inline-flex;color:var(--accent)}
  .icon svg{width:100%;height:100%;display:block}
  .brand .agent{color:var(--accent)}
  .brand .tag{color:var(--muted);font-weight:450;font-size:12.5px}
  .ctx{margin-left:6px;display:flex;gap:8px;flex-wrap:wrap}
  .chip{font-size:11.5px;color:var(--muted);border:1px solid var(--border);
    border-radius:999px;padding:3px 10px;background:var(--card)}
  #bar .right{margin-left:auto;display:flex;align-items:center;gap:14px}
  #counter{font-variant-numeric:tabular-nums;color:var(--muted);font-size:12.5px}
  .btn{cursor:pointer;background:var(--card);color:var(--text);border:1px solid var(--border);
    border-radius:7px;padding:5px 12px;font-size:12.5px;transition:.15s}
  .btn:hover{border-color:var(--accent)}

  /* ---- stage ---- */
  #stage{position:relative;height:calc(100vh - 118px);overflow:hidden;transition:height .35s ease}
  body.foot-collapsed #stage{height:calc(100vh - 62px)}
  .screen{position:absolute;inset:0;display:flex;flex-direction:column;
    padding:34px 6vw;opacity:0;transform:translateY(14px);
    transition:opacity .5s ease,transform .5s ease;pointer-events:none}
  .screen.show{opacity:1;transform:none}
  .kicker{font-size:13px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
    color:var(--accent);display:flex;align-items:center;gap:9px;margin-bottom:8px}
  .kicker .em{font-size:17px}
  .exptitle{font-size:13px;color:var(--subt);margin-bottom:22px;font-variant-numeric:tabular-nums}

  /* hypothesis */
  .hyp-wrap{margin:auto 0;max-width:1100px}
  .statement{font-size:clamp(26px,3.6vw,46px);line-height:1.28;font-weight:600;
    letter-spacing:-.01em}
  .statement code{background:color-mix(in srgb,var(--accent) 13%,transparent);
    color:var(--accent);padding:.06em .32em;border-radius:6px;font-size:.86em}
  .gain{margin-top:26px;display:inline-flex;align-items:center;gap:10px;font-size:16px;
    color:var(--muted)}
  .gain b{color:var(--text)}

  /* change / diff */
  .diff-head{font-size:clamp(19px,2.2vw,28px);font-weight:600;margin-bottom:4px}
  .diff-sub{color:var(--muted);font-size:14px;margin-bottom:16px}
  .diffbox{flex:1;overflow:auto;background:var(--codebg);border:1px solid var(--border);
    border-radius:12px;box-shadow:var(--shadow);font:13.5px/1.65 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
  .fname{padding:9px 16px;border-bottom:1px solid var(--border);color:var(--muted);
    font-size:12.5px;position:sticky;top:0;background:var(--codebg)}
  .dl{display:flex;white-space:pre;padding:0 14px}
  .dl .g{width:2ch;flex:0 0 2ch;text-align:center;color:var(--subt);user-select:none;opacity:.8}
  .dl.add{background:var(--add-bg);color:var(--add-fg)} .dl.add .g{color:var(--add-gutter)}
  .dl.del{background:var(--del-bg);color:var(--del-fg)} .dl.del .g{color:var(--del-gutter)}
  .dl.hunk{color:var(--hunk);margin:4px 0} .dl.meta{color:var(--meta)}
  .diff-empty{margin:auto;color:var(--subt);font-size:15px;text-align:center}

  /* result */
  .res-head{display:flex;align-items:flex-end;gap:20px;margin-bottom:6px}
  .bestwrap{display:flex;flex-direction:column}
  .bestlabel{font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
  .bestval{font-size:clamp(44px,7vw,86px);font-weight:800;line-height:1;color:var(--accent);
    font-variant-numeric:tabular-nums;letter-spacing:-.02em}
  .delta{font-size:15px;font-weight:700;padding:5px 12px;border-radius:999px;align-self:center}
  .delta.up{color:var(--add-fg);background:var(--add-bg)}
  .delta.flat{color:var(--muted);background:var(--card);border:1px solid var(--border)}
  .verdict{align-self:center;margin-left:auto;font-size:13px;font-weight:700;
    padding:6px 14px;border-radius:8px;text-transform:capitalize}
  .v-supported{color:var(--add-fg);background:var(--add-bg)}
  .v-refuted,.v-invalid{color:var(--del-fg);background:var(--del-bg)}
  .v-inconclusive,.v-baseline,.v-,.v-potential{color:var(--muted);background:var(--card);border:1px solid var(--border)}
  #chart{flex:1;width:100%;min-height:0}

  /* intro / outro */
  .center{margin:auto;text-align:center;max-width:1000px}
  .big{font-size:clamp(36px,6vw,74px);font-weight:800;letter-spacing:-.02em;line-height:1.08}
  .big .agent{color:var(--accent)}
  .lede{margin-top:22px;font-size:clamp(16px,2vw,22px);color:var(--muted);line-height:1.5}
  .statline{margin-top:34px;display:flex;gap:38px;justify-content:center;flex-wrap:wrap}
  .stat{display:flex;flex-direction:column;gap:4px}
  .stat .n{font-size:clamp(30px,4vw,52px);font-weight:800;color:var(--accent);font-variant-numeric:tabular-nums}
  .stat .l{font-size:13px;color:var(--muted);letter-spacing:.04em}

  /* ---- footer / controls ---- */
  #foot{height:56px;display:flex;align-items:center;gap:16px;padding:0 26px;
    border-top:1px solid var(--border);background:var(--panel);
    transition:transform .35s ease}
  body.foot-collapsed #foot{transform:translateY(100%)}
  /* collapse handle — a small pill tab riding the top edge of the footer */
  #footToggle{position:fixed;right:22px;bottom:56px;z-index:5;cursor:pointer;
    width:34px;height:20px;border:1px solid var(--border);border-bottom:none;
    border-radius:8px 8px 0 0;background:var(--panel);color:var(--muted);
    display:flex;align-items:center;justify-content:center;font-size:12px;line-height:1;
    transition:bottom .35s ease,color .15s,border-color .15s}
  #footToggle:hover{color:var(--accent);border-color:var(--accent)}
  body.foot-collapsed #footToggle{bottom:0;border-radius:8px}
  #footToggle .ico{transition:transform .35s ease}
  body.foot-collapsed #footToggle .ico{transform:rotate(180deg)}
  #prog{flex:1;height:6px;border-radius:999px;background:var(--grid);overflow:hidden}
  #progfill{height:100%;width:0;background:var(--accent);transition:width .4s ease}
  .speedctl{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted);
    border:1px solid var(--border);border-radius:7px;padding:3px 8px;background:var(--card)}
  .speedctl input{width:46px;background:transparent;border:none;color:var(--text);
    font:inherit;font-variant-numeric:tabular-nums;text-align:right;outline:none}
  .speedctl input::-webkit-outer-spin-button,.speedctl input::-webkit-inner-spin-button{opacity:1}
  .keys{color:var(--subt);font-size:11.5px}
  .keys kbd{border:1px solid var(--border);border-bottom-width:2px;border-radius:5px;
    padding:1px 6px;font-family:inherit;font-size:11px;color:var(--muted);margin:0 1px}
</style>
</head>
<body>
<div id="bar">
  <div class="brand"><span class="icon" id="agentIcon"></span>
    <span class="agent" id="agentName">Agent</span>
    <span class="tag">· autonomous TPU optimization</span>
  </div>
  <div class="ctx" id="ctx"></div>
  <div class="right">
    <span id="counter"></span>
    <button class="btn" id="playBtn">⏸ Pause</button>
    <button class="btn" id="themeBtn">🌙 Dark</button>
  </div>
</div>

<div id="stage"></div>

<button id="footToggle" title="Hide / show controls (H)"><span class="ico">▾</span></button>

<div id="foot">
  <button class="btn" id="prevBtn">‹ Prev</button>
  <div id="prog"><div id="progfill"></div></div>
  <button class="btn" id="nextBtn">Next ›</button>
  <label class="speedctl" title="Seconds per slide (auto-advance)">
    ⏱ <input id="speedInput" type="number" min="0.3" max="30" step="0.1"> s/slide
  </label>
  <span class="keys"><kbd>&lt;</kbd><kbd>&gt;</kbd> step · <kbd>Space</kbd> pause · <kbd>T</kbd> theme · <kbd>H</kbd> hide</span>
</div>

<script>
const P = __PAYLOAD__;
const EXPS = P.experiments;
const ACCENT = P.color;
document.documentElement.style.setProperty("--accent", ACCENT);

// ---- theme ----
function setTheme(dark){
  document.body.classList.toggle("dark", dark);
  document.getElementById("themeBtn").textContent = dark ? "☀ Light" : "🌙 Dark";
  if (typeof render === "function" && steps[cur] && steps[cur].type==="result") drawChart(steps[cur].idx, true);
  if (typeof render === "function" && steps[cur] && (steps[cur].type==="intro"||steps[cur].type==="outro")) {
    const k = steps[cur].type==="intro" ? -1 : EXPS.length-1; drawChart(k, true);
  }
}
document.getElementById("themeBtn").onclick = ()=> setTheme(!document.body.classList.contains("dark"));

// ---- header chrome ----
document.getElementById("agentName").textContent = P.agentName;
document.getElementById("agentIcon").innerHTML = P.icon || "";
document.getElementById("ctx").innerHTML =
  [P.model.toUpperCase(), P.lane, (P.seq==="all"?"2k+8k":P.seq/1000+"k ctx")]
    .map(c=>`<span class="chip">${c}</span>`).join("");

function cssvar(n){ return getComputedStyle(document.body).getPropertyValue(n).trim(); }
function esc(s){ return s.replace(/[&<>]/g, c=>({"&":"&amp;","<":"&lt;",">":"&gt;"}[c])); }

// ---- build the flat step list: intro, then hypothesis/change/result per exp, then outro ----
const steps = [{type:"intro"}];
EXPS.forEach((e,i)=>{
  const isBaseline = (e.verdict||"").toLowerCase()==="baseline";
  // baselines have no idea/change — show them only as a starting point on the chart.
  if(!isBaseline && (e.hypothesis_statement || e.hypothesis_title)) steps.push({type:"hypothesis", idx:i});
  if(!isBaseline && e.diff && e.diff.trim())                        steps.push({type:"change", idx:i});
  steps.push({type:"result", idx:i});
});
steps.push({type:"outro"});

const stage = document.getElementById("stage");
let cur = 0, playing = true, timer = null;

// screen factory -----------------------------------------------------------
function screenEl(){ const d=document.createElement("div"); d.className="screen"; return d; }

function renderIntro(){
  const d = screenEl();
  const supported = EXPS.filter(e=>e.verdict==="supported").length;
  d.innerHTML = `<div class="center">
    <div class="big"><span class="agent">${P.agentName}</span> optimized ${P.model.toUpperCase()} on TPU<br>— on its own.</div>
    <div class="lede">${EXPS.length} experiments. Each one: a hypothesis it formed, a change it wrote,
      a result it measured — then the next idea. No human in the loop.</div>
    <div class="statline">
      <div class="stat"><span class="n">${EXPS.length}</span><span class="l">experiments run</span></div>
      <div class="stat"><span class="n">${supported}</span><span class="l">that moved the metric</span></div>
      <div class="stat"><span class="n">${fmtMfu(bestOf(EXPS.length-1))}</span><span class="l">peak MFU reached</span></div>
    </div>
    <div id="chart"></div>
  </div>`;
  return d;
}

function renderHyp(e){
  const d = screenEl();
  let st = e.hypothesis_statement || e.hypothesis_title || "(hypothesis)";
  st = esc(st).replace(/`([^`]+)`/g, "<code>$1</code>");
  const gain = e.expected_gain ? `<div class="gain">🎯 expected: <b>${esc(e.expected_gain)}</b></div>` : "";
  d.innerHTML = `
    <div class="kicker"><span class="em">💡</span> Hypothesis</div>
    <div class="exptitle">${expLabel(e)}</div>
    <div class="hyp-wrap"><div class="statement">${st}</div>${gain}</div>`;
  return d;
}

function renderChange(e){
  const d = screenEl();
  d.innerHTML = `
    <div class="kicker"><span class="em">🔧</span> Change applied</div>
    <div class="diff-head">${esc(e.diff_summary || e.title || "")}</div>
    <div class="diff-sub">${diffKindLabel(e)}</div>
    <div class="diffbox" id="diffbox"></div>`;
  const box = d.querySelector("#diffbox");
  box.innerHTML = renderDiff(e.diff);
  return d;
}

function renderResult(e, idx){
  const d = screenEl();
  const v = (e.verdict||"").toLowerCase();
  const isBaseline = v==="baseline";
  const best = e.bestMfu, delta = e.delta;
  const label = isBaseline ? "Baseline MFU" : "Best MFU";
  const dchip = isBaseline
      ? `<span class="delta flat">starting point</span>`
      : (e.isNewBest && delta)
        ? `<span class="delta up">▲ +${delta.toFixed(1)}%</span>`
        : `<span class="delta flat">frontier ${fmtMfu(best)}</span>`;
  d.innerHTML = `
    <div class="res-head">
      <div class="bestwrap">
        <span class="bestlabel">${label}</span>
        <span class="bestval">${fmtMfu(isBaseline ? e.mfu : best)}</span>
      </div>
      ${dchip}
      <span class="verdict v-${v}">${v||"—"}</span>
    </div>
    <div class="exptitle">${expLabel(e)} · this run: ${e.mfu!=null?e.mfu.toFixed(1)+"% MFU":"—"}${e.tps?(" · "+e.tps.toLocaleString()+" tok/s/chip"):""}</div>
    <div id="chart"></div>`;
  return d;
}

// diff rendering (red-/green+) ---------------------------------------------
function renderDiff(diff){
  if(!diff || !diff.trim()){
    return `<div class="diff-empty">— change captured in the run config —<br><span style="opacity:.6">diff precompute pending</span></div>`;
  }
  const out = [];
  for(const raw of diff.split("\n")){
    const line = raw.replace(/\r$/,"");
    let cls="", g=" ", body=line;
    if(/^(\+\+\+|---) /.test(line)){ cls="meta"; g=" "; }
    else if(/^diff |^index |^new file|^deleted file|^rename /.test(line)){ cls="meta"; g=" "; }
    else if(line.startsWith("@@")){ cls="hunk"; g="…"; }
    else if(line.startsWith("+")){ cls="add"; g="+"; body=line.slice(1); }
    else if(line.startsWith("-")){ cls="del"; g="-"; body=line.slice(1); }
    else { body = line.startsWith(" ") ? line.slice(1) : line; }
    // filename header for +++ line
    if(/^\+\+\+ /.test(line)){
      out.push(`<div class="fname">${esc(line.replace(/^\+\+\+ (b\/)?/,""))}</div>`);
      continue;
    }
    if(/^--- /.test(line)) continue; // fold the paired --- header
    out.push(`<div class="dl ${cls}"><span class="g">${esc(g)}</span><span>${esc(body)||" "}</span></div>`);
  }
  return out.join("");
}

// helpers ------------------------------------------------------------------
function fmtMfu(v){ return v==null ? "—" : v.toFixed(1)+"%"; }
function bestOf(idx){ let b=null; for(let i=0;i<=idx;i++){const e=EXPS[i]; if(e.mfu!=null&&e.verdict!=="invalid"&&(b==null||e.mfu>b))b=e.mfu;} return b; }
function expLabel(e){ return `exp #${e.vnum} — ${esc((e.title||e.slug))}`; }
function diffKindLabel(e){
  return {code:"code diff — model / trainer", flag:"config diff — launch flags",
          none:"configuration change"}[e.diff_kind] || "change";
}

// ---- bespoke SVG chart (offline, animatable) ----
function drawChart(uptoIdx, instant){
  const host = document.getElementById("chart");
  if(!host) return;
  const W=host.clientWidth||1000, H=host.clientHeight||460;
  const mL=54, mR=30, mT=26, mB=34;
  const pts = EXPS.map((e,i)=>({e,i})).filter(o=>o.i<=uptoIdx && o.e.mfu!=null);
  const target = P.maxtextTarget;
  const ys = pts.map(o=>o.e.mfu).concat(target?[target]:[]);
  const ymax = Math.max(...ys, 10) * 1.12, ymin = Math.max(0, Math.min(...ys, 100)*0.82);
  const n = EXPS.length;
  const X = i => mL + (W-mL-mR) * (n<=1?0.5:i/(n-1));
  const Y = v => H-mB - (H-mT-mB) * (v-ymin)/(ymax-ymin||1);
  const col = { grid:cssvar("--grid"), axis:cssvar("--subt"), muted:cssvar("--muted"), text:cssvar("--text") };
  const NS="http://www.w3.org/2000/svg";
  const svg = document.createElementNS(NS,"svg");
  svg.setAttribute("viewBox",`0 0 ${W} ${H}`); svg.setAttribute("width","100%"); svg.setAttribute("height","100%");

  function line(x1,y1,x2,y2,stroke,w,dash){ const l=document.createElementNS(NS,"line");
    l.setAttribute("x1",x1);l.setAttribute("y1",y1);l.setAttribute("x2",x2);l.setAttribute("y2",y2);
    l.setAttribute("stroke",stroke);l.setAttribute("stroke-width",w); if(dash)l.setAttribute("stroke-dasharray",dash); svg.appendChild(l); return l; }
  function txt(x,y,s,fill,size,anchor){ const t=document.createElementNS(NS,"text");
    t.setAttribute("x",x);t.setAttribute("y",y);t.setAttribute("fill",fill);t.setAttribute("font-size",size||12);
    t.setAttribute("text-anchor",anchor||"start");t.setAttribute("font-family","inherit");t.textContent=s; svg.appendChild(t); return t; }

  // y gridlines
  const ticks=4;
  for(let k=0;k<=ticks;k++){ const v=ymin+(ymax-ymin)*k/ticks, y=Y(v);
    line(mL,y,W-mR,y,col.grid,1); txt(mL-8,y+4,v.toFixed(0)+"%",col.axis,11,"end"); }
  txt(mL-38,mT+4,"MFU",col.muted,11,"start");

  // MaxText target reference
  if(target){ const y=Y(target); line(mL,y,W-mR,y,col.muted,1.5,"6 5");
    txt(W-mR-4,y-6,"MaxText SOTA "+target.toFixed(1)+"%",col.muted,11,"end"); }

  // frontier (running best) step line
  let b=null; const fx=[], fy=[];
  for(let i=0;i<=uptoIdx;i++){ const e=EXPS[i]; if(e.mfu!=null&&e.verdict!=="invalid"){ if(b==null||e.mfu>b)b=e.mfu; }
    if(b!=null){ fx.push(X(i)); fy.push(Y(b)); } }
  if(fx.length>1){ let dd=`M ${fx[0]} ${fy[0]}`; for(let i=1;i<fx.length;i++){ dd+=` L ${fx[i]} ${fy[i-1]} L ${fx[i]} ${fy[i]}`; }
    const path=document.createElementNS(NS,"path"); path.setAttribute("d",dd); path.setAttribute("fill","none");
    path.setAttribute("stroke",ACCENT); path.setAttribute("stroke-width",3); path.setAttribute("stroke-linejoin","round");
    svg.appendChild(path);
    if(!instant){ const len=path.getTotalLength(); path.style.strokeDasharray=len; path.style.strokeDashoffset=len;
      path.animate([{strokeDashoffset:len},{strokeDashoffset:0}],{duration:600,easing:"ease-out",fill:"forwards"}); } }

  // points
  pts.forEach(o=>{
    const e=o.e, x=X(o.i), y=Y(e.mfu);
    const fail = ["invalid","refuted","inconclusive"].includes((e.verdict||"").toLowerCase());
    const c=document.createElementNS(NS,"circle"); c.setAttribute("cx",x); c.setAttribute("cy",y);
    c.setAttribute("r", o.i===uptoIdx?7:4.5);
    c.setAttribute("fill", fail?cssvar("--panel"):ACCENT);
    c.setAttribute("stroke",ACCENT); c.setAttribute("stroke-width", fail?1.5:1);
    if(o.i===uptoIdx){ c.setAttribute("stroke-width",2.5);
      if(!instant) c.animate([{r:0,opacity:0},{r:11,opacity:1},{r:7,opacity:1}],{duration:480,easing:"ease-out"});
    }
    svg.appendChild(c);
  });

  host.innerHTML=""; host.appendChild(svg);
}

// ---- navigation / playback ----
function durationFor(t){ const s=P.speed*1000; return {intro:s*1.5, hypothesis:s, change:s*1.35, result:s*1.45, outro:s*2.2}[t]||s; }

function render(){
  const step = steps[cur];
  let el;
  if(step.type==="intro") el=renderIntro();
  else if(step.type==="outro") el=renderOutro();
  else { const e=EXPS[step.idx];
    el = step.type==="hypothesis"?renderHyp(e): step.type==="change"?renderChange(e): renderResult(e,step.idx); }
  stage.innerHTML=""; stage.appendChild(el);
  requestAnimationFrame(()=>{ el.classList.add("show");
    if(step.type==="result") drawChart(step.idx);
    else if(step.type==="intro") drawChart(-1, true);
  });
  // counter + progress
  const ei = step.idx!=null ? step.idx+1 : (step.type==="intro"?0:EXPS.length);
  document.getElementById("counter").textContent =
    step.type==="intro"||step.type==="outro" ? (step.type==="intro"?"intro":"summary")
      : `exp ${ei} / ${EXPS.length}`;
  document.getElementById("progfill").style.width = (100*cur/(steps.length-1))+"%";
  schedule();
}

function renderOutro(){
  const d=screenEl(); const best=bestOf(EXPS.length-1), first=EXPS.find(e=>e.mfu!=null);
  const start=first?first.mfu:null;
  d.innerHTML = `<div class="center">
    <div class="big">${start!=null?fmtMfu(start):"—"} <span style="color:var(--subt)">→</span> <span class="agent">${fmtMfu(best)}</span> MFU</div>
    <div class="lede">${P.agentName} climbed the frontier across ${EXPS.length} experiments —
      hypothesis, change, measurement — fully autonomously.</div>
    <div id="chart" style="height:44vh;margin-top:20px"></div>
  </div>`;
  return d;
}

function schedule(){ clearTimeout(timer);
  if(playing && cur<steps.length-1) timer=setTimeout(()=>go(1), durationFor(steps[cur].type)); }
function go(dir){ const n=cur+dir; if(n<0||n>=steps.length) return; cur=n; render(); }
function setPlay(p){ playing=p; document.getElementById("playBtn").textContent=p?"⏸ Pause":"▶ Play";
  if(p) schedule(); else clearTimeout(timer); }

document.getElementById("nextBtn").onclick=()=>{ setPlay(false); go(1); };
document.getElementById("prevBtn").onclick=()=>{ setPlay(false); go(-1); };
document.getElementById("playBtn").onclick=()=> setPlay(!playing);

// collapsible footer
function redrawCurrent(){ const s=steps[cur];
  if(s.type==="result") drawChart(s.idx,true);
  else if(s.type==="intro") drawChart(-1,true);
  else if(s.type==="outro") drawChart(EXPS.length-1,true); }
function toggleFoot(){ document.body.classList.toggle("foot-collapsed");
  setTimeout(redrawCurrent, 380); }   // chart refits after the height transition
document.getElementById("footToggle").onclick=toggleFoot;

// per-slide auto-advance time
const speedInput=document.getElementById("speedInput");
speedInput.value = P.speed;
speedInput.addEventListener("input", ()=>{ const v=parseFloat(speedInput.value);
  if(!isNaN(v) && v>=0.1){ P.speed=v; if(playing) schedule(); } });
// avoid keyboard nav while typing in the speed box
speedInput.addEventListener("keydown", ev=>ev.stopPropagation());
window.addEventListener("keydown", ev=>{
  if(ev.key===">"||ev.key==="."||ev.key==="ArrowRight"){ setPlay(false); go(1); }
  else if(ev.key==="<"||ev.key===","||ev.key==="ArrowLeft"){ setPlay(false); go(-1); }
  else if(ev.key===" "){ ev.preventDefault(); setPlay(!playing); }
  else if(ev.key==="t"||ev.key==="T"){ setTheme(!document.body.classList.contains("dark")); }
  else if(ev.key==="h"||ev.key==="H"){ toggleFoot(); }
});
window.addEventListener("resize", ()=>{ const s=steps[cur];
  if(s.type==="result") drawChart(s.idx,true);
  else if(s.type==="intro") drawChart(-1,true);
  else if(s.type==="outro") drawChart(EXPS.length-1,true); });

// initial theme from OS preference, then start
setTheme(window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches);
render();
</script>
</body>
</html>
